+    #[test]
+    fn calibration_uses_user_layer_and_reports_a_rejected_override() {
+        let root = std::env::temp_dir().join(format!(
+            "microduck-cal-layer-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        std::fs::create_dir_all(&root).unwrap();
+        let (base, user, cal) = (
+            root.join("base.toml"),
+            root.join("user.toml"),
+            root.join("cal.toml"),
+        );
+        std::fs::write(&base, "[control]\nhz=50\n").unwrap();
+        let data = RobotCalibration {
+            schema: 2,
+            target_tag: "daemon-v0.18.3".into(),
+            joint_zero_rad: [0.0; 15],
+            joint_direction: [1; 15],
+            imu_mount_wxyz: [1.0, 0.0, 0.0, 0.0],
+            imu_module: "bus_imu200".into(),
+            gyro_profile: "custom_raw_div_16_4".into(),
+            gyro_raw_counts_per_dps: 16.4,
+        };
+        std::fs::write(&cal, toml::to_string(&data).unwrap()).unwrap();
+        std::fs::write(
+            &user,
+            format!(
+                "[bus]\ncalibration_path = {:?}\n",
+                cal.display().to_string()
+            ),
+        )
+        .unwrap();
+        let parsed = Params::load_layered(&base, &user, true).unwrap();
+        assert!(parsed.user_layer_rejected.is_none());
+        assert_eq!(
+            parsed
+                .bus
+                .load_calibration()
+                .unwrap()
+                .unwrap()
+                .gyro_raw_counts_per_dps,
+            16.4
+        );
+        assert_eq!(
+            std::fs::read_to_string(&base).unwrap(),
+            "[control]\nhz=50\n"
+        );
+        std::fs::write(&user, "[bus]\ncalibration_path=\"relative.toml\"\n").unwrap();
+        let fallback = Params::load_layered(&base, &user, true).unwrap();
+        assert!(fallback.user_layer_rejected.is_some());
+        assert!(fallback.bus.calibration_path.is_empty());
+        std::fs::remove_dir_all(root).unwrap();
+    }
+}
