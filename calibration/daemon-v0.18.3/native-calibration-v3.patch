+/// Report only what the live DynamixelIo decoder really holds, never re-read a
+/// changed calibration file and mistake pending settings for active settings.
+#[cfg(target_os = "linux")]
+fn write_effective_calibration(
+    io: &duck_control::bus::DynamixelIo,
+    bus: &params::Bus,
+    config_path: &std::path::Path,
+    config_error: Option<&str>,
+) -> std::io::Result<()> {
+    let (zeros, dirs, mount, counts) = io.effective_calibration();
+    let payload = serde_json::json!({
+        "source": "robotd:DynamixelIo:live",
+        "target_tag": "daemon-v0.18.3",
+        "pid": std::process::id(),
+        "bus_verified": true,
+        "native_calibration_contract": "microduck-calibration/v2",
+        "base_revision": "b2b0d213a402caeac492dd662ea891faa17f67c0",
+        "daemon_version": env!("CARGO_PKG_VERSION"),
+        "build_revision": option_env!("DUCK_REVISION"),
+        "executable": std::env::current_exe().ok().map(|p| p.display().to_string()),
+        "config_path": config_path.display().to_string(),
+        "config_layering": "user-over-base/v1",
+        "user_config_path": params::user_layer_for(config_path).map(|p| p.display().to_string()),
+        "user_layer_rejected": config_error,
+        "calibration_active": !bus.calibration_path.is_empty(),
+        "calibration_path": bus.calibration_path,
+        "imu_module": "bus_imu200",
+        "gyro_raw_counts_per_dps": counts,
+        "gyro_rad_per_raw_count": std::f64::consts::PI / (180.0 * counts),
+        "gyro_deg_per_raw_count": 1.0 / counts,
+        "imu_mount_wxyz": mount,
+        "joint_zero_rad": zeros,
+        "joint_direction": dirs,
+    });
+    let dir = std::path::Path::new("/run/robotd");
+    let tmp = dir.join(format!(".calibration-effective-{}.tmp", std::process::id()));
+    let dest = dir.join("calibration-effective.json");
+    let bytes = serde_json::to_vec_pretty(&payload).map_err(std::io::Error::other)?;
+    std::fs::write(&tmp, bytes)?;
+    std::fs::rename(&tmp, &dest)
+}
